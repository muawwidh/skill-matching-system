PROJECT_NAME="Skill Gap Job Matching System"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG="true"

DATABASE_URL="postgresql+psycopg://skillgap:skillgap@db:5432/skillgap"
SECRET_KEY="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"

POSTGRES_USER="skillgap"
POSTGRES_PASSWORD="skillgap"
POSTGRES_DB="skillgap"

VITE_API_BASE_URL="http://localhost:8000"

# Live job import (docs/DECISIONS.md D052-D056). Lists: "a,b" or a JSON array.
LIVE_JOB_SOURCES="arbeitnow,greenhouse"
# GREENHOUSE_BOARDS="gitlab,elastic,..."   # default: 20 verified boards, see backend/app/core/config.py
LIVE_JOBS_MAX_ACTIVE="1500"
LIVE_JOBS_MAX_SOURCE_SHARE="0.7"
LIVE_JOBS_ARCHIVE_AFTER_DAYS="14"
LIVE_JOBS_ENGLISH_ONLY="true"
LIVE_JOBS_EUROPE_OR_REMOTE_ONLY="true"
CANDIDATE_VIEW_INCLUDES_EVALUATION_JOBS="false"
